# FOX MEDIA WORKER — outbound-only compute worker for FOX MIX CORE.
# Runs ALONGSIDE (never replaces) tg-comfy-bot.service / comfyui / ollama.
# Install (only after tests pass and you approve):
#   sudo cp deploy/fox-media-worker.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now fox-media-worker.service
# Secrets are read from the project .env (chmod 600); none are baked into this unit.

[Unit]
Description=FOX MEDIA WORKER (FOX MIX compute worker)
After=network-online.target comfyui.service
Wants=network-online.target
# Does not require the bot; they are independent consumers of ComfyUI.

[Service]
Type=simple
User=iaadmin
Group=iaadmin
WorkingDirectory=/home/iaadmin/tg_comfy_bot
EnvironmentFile=/home/iaadmin/tg_comfy_bot/.env
ExecStart=/home/iaadmin/tg_comfy_bot/venv/bin/python -m fox_worker.main
Restart=on-failure
RestartSec=5
# systemd creates/owns /var/lib/fox-media-worker (matches FOX_JOBS_DIR in .env); the worker also
# falls back to a project-local dir if this is ever unavailable.
StateDirectory=fox-media-worker
# Do not thrash on a persistent failure (e.g. bad config): back off if it crashes repeatedly.
StartLimitIntervalSec=60
StartLimitBurst=5
# Keep the worker low-priority for the shared GPU relative to interactive bot jobs.
Nice=10
# Basic hardening (worker only needs its project dir + the jobs dir).
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
