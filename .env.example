# ==== FOX MEDIA WORKER + generator config — copy to .env and fill in (chmod 600) ====
# .env is gitignored. NEVER commit real values. NEVER log these.

# Existing generator (Telegram) token — same one the bot uses. Lets tools/complex_gen.py
# read it from env instead of hardcoding it.
GENERATOR_TELEGRAM_TOKEN=

# ---- FOX MIX CORE connection (worker makes OUTBOUND requests only) ----
FOX_CORE_URL=
FOX_WORKER_TOKEN=
FOX_WORKER_ID=fox-media-worker-1

# ---- worker behaviour ----
FOX_POLL_SECONDS=5
FOX_HEARTBEAT_SECONDS=30
FOX_WORKER_MOCK_GENERATION=false
FOX_JOBS_DIR=/var/lib/fox-media-worker/jobs
FOX_ARTIFACT_RETENTION_HOURS=24

# ---- local backends (localhost only — never expose to the internet) ----
COMFY_BASE=http://127.0.0.1:8188
OLLAMA_BASE=http://127.0.0.1:11434
